# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# --- Stripe (https://dashboard.stripe.com/apikeys) — use sk_test_ keys locally
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: production site URL, fallback for redirect URLs.
# NEXT_PUBLIC_SITE_URL=

# --- Contact form delivery (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional override of the verified sender; defaults to website@updates.robfrew.com
# CONTACT_FROM_EMAIL=

# --- Contact form bot check (Cloudflare Turnstile)
# Production keys come from a Turnstile widget in the Cloudflare dashboard.
# The values below are Cloudflare's documented TEST keys: the widget always
# passes and siteverify always succeeds, so they are safe for local dev only.
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- TrAction (local Supabase stack only; production values live in Vercel)
TRACTION_SUPABASE_URL=
TRACTION_SUPABASE_SECRET_KEY=
TRACTION_SUPABASE_PUBLISHABLE_KEY=
